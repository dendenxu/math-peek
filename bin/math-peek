#!/bin/sh
set -eu

cli="$HOME/Applications/Math Peek.app/Contents/MacOS/MathPeekCLI"
if [ ! -x "$cli" ]; then
    cli="/Applications/Math Peek.app/Contents/MacOS/MathPeekCLI"
fi
if [ ! -x "$cli" ]; then
    echo "math-peek: Math Peek is not installed; run ./install.sh first." >&2
    exit 1
fi
exec "$cli" "$@"
